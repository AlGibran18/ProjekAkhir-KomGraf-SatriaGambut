[node name="Title" type="Label" parent="GuideModal/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 24
text = "PANDUAN & SOP 6 LANGKAH SATRIA GAMBUT"

[node name="Body" type="Label" parent="GuideModal/VBox"]
layout_mode = 2
size_flags_vertical = 3
text = "1. RENCANA & ANALISIS: Identifikasi zona merah (risiko PFVI ekstrem) di peta taktis, lalu pasang Sumur Air di tepi zona rawan.\n\n2. WABAH KEBAKARAN: Masuki hutan gambut 3D First-Person. Waspadai arah angin yang mendorong penyebaran api.\n\n3. BUAT SEKAT API [Tombol 1]: Gali parit sekat bakar di jalur rambatan api untuk menghentikan api.\n\n4. TEMUKAN HOTSPOT DALAM [Tombol 2 + Tab]: Padamkan api permukaan dengan Semprot Air [2]. Jika asap tipis masih mengepul, tekan [Tab] Thermal X-Ray untuk mendeteksi bara bawah tanah (kedalaman 1,5 m+).\n\n5. INJEKSI AIR [Tombol 3]: Tancapkan Tombak Gambut [3] dengan menahan Klik Kiri pada titik bara hingga bar injeksi penuh dan uap menyembur!\n\n6. MISI BERHASIL: Padamkan 100% hotspot untuk melindungi hutan dan cadangan karbon gambut. Dekati Sumur Air untuk isi ulang tangki."
autowrap_mode = 3

[node name="BtnCloseGuide" type="Button" parent="GuideModal/VBox"]
